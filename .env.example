# Lokální vývoj bez Dockeru pro API (npm run db && npm run dev:api). docker compose si proměnné nastaví sám.
NODE_ENV=development
DATABASE_URL=postgres://etfd:etfd@localhost:5544/etfd
SITE_URL=http://localhost:3000

# Admin /admin a ruční spuštění cronu (mimo development bez nich zavřeno)
ADMIN_TOKEN=
CRON_SECRET=
CRON_SCHEDULE=0 7 * * *

# E-maily (Resend, doména musí být ověřená) – bez nich se kroky sekvence označí jako přeskočené
RESEND_API_KEY=
RESEND_FROM="ETF dvojčata <report@vasedomena.cz>"
DAILY_EMAIL_CAP=300
DAILY_NURTURE_CAP=300

# Předání leadu s telefonem do CRM / call centra (POST JSON). Podpis: x-webhook-signature = sha256=HMAC(secret, `${x-webhook-timestamp}.${body}`)
# Na veřejném webu (https) musí být webhook https a mít secret
HANDOFF_WEBHOOK_URL=
HANDOFF_WEBHOOK_SECRET=

# Web: kde běží NestJS API (výchozí http://localhost:4000)
# API_URL=http://localhost:4000

# Volitelně PostHog (cookieless) – heatmapy a záznamy relací navíc k vlastnímu měření
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com
