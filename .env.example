# Lokálně není nic povinné: DB běží v PGlite (.data/), e-maily se jen označí jako přeskočené, admin je otevřený v `next dev`.

# Postgres (Neon přes Vercel Marketplace). V produkci povinné – migrace proběhnou při `npm run build`.
DATABASE_URL=

# Kanonická adresa webu (odkazy v e-mailech, kontrola Origin). Na Vercelu jinak VERCEL_PROJECT_PRODUCTION_URL.
SITE_URL=https://etf-dvojcata.vercel.app

# Admin /admin (mimo `next dev` bez tokenu zavřeno)
ADMIN_TOKEN=

# Vercel Cron posílá Authorization: Bearer $CRON_SECRET (mimo `next dev` bez něj zavřeno)
CRON_SECRET=

# E-maily (Resend, doména musí být ověřená)
RESEND_API_KEY=
RESEND_FROM="ETF dvojčata <report@vasedomena.cz>"
DAILY_EMAIL_CAP=300
DAILY_NURTURE_CAP=300

# Předání leadu s telefonem do CRM / call centra (POST JSON, hlavička x-webhook-secret)
HANDOFF_WEBHOOK_URL=
HANDOFF_WEBHOOK_SECRET=

# Ochrana formuláře (mobilní operátoři sdílejí IP – limit nesmí být moc přísný)
LEADS_PER_IP_10MIN=20

# Volitelně PostHog (cookieless) – heatmapy a záznamy relací navíc k vlastnímu měření
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com
