# Vše je volitelné – bez proměnných stránka běží, leady i události se drží jen v paměti.

# Úložiště leadů a funnelu (Upstash Redis, free tier; na Vercelu Marketplace → Upstash nastaví i KV_REST_API_*)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# E-mail s přehledem po odeslání formuláře (Resend, free 100 e-mailů/den; doména musí být ověřená)
RESEND_API_KEY=
RESEND_FROM="ETF dvojčata <prehled@vasedomena.cz>"

# Ochrana /stats.html – token se zadá na stránce; v produkci bez tokenu je /api/stats zavřené
STATS_TOKEN=

# Kanonická adresa webu (odkazy v e-mailu + kontrola Origin u formuláře)
SITE_URL=https://etf-dvojcata.vercel.app

# Ochrana proti zneužití formuláře
LEADS_PER_IP_10MIN=20
DAILY_EMAIL_CAP=300

# Volitelně PostHog (cookieless, persistence: memory) – funnely a session replay navíc k vlastnímu měření
VITE_POSTHOG_KEY=
VITE_POSTHOG_HOST=https://eu.i.posthog.com
